<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="Controllers.RegisterController"
      alignment="CENTER"
      spacing="20"
      style="-fx-padding: 30; -fx-background-color: linear-gradient(to bottom, #f8f9fa, #e9ecef);">

    <!-- Заголовок регистрации -->
    <VBox alignment="CENTER" spacing="10">
        <StackPane>
            <!-- Иконка дома -->
            <StackPane>
                <Rectangle width="60" height="45" fill="#0d6efd" arcWidth="5" arcHeight="5"/>
                <Rectangle width="70" height="15" fill="#0d6efd" arcWidth="5" arcHeight="5" translateY="-30"/>
                <HBox alignment="CENTER" spacing="15">
                    <Rectangle width="10" height="15" fill="#ffffff"/>
                    <Rectangle width="10" height="15" fill="#ffffff"/>
                </HBox>
            </StackPane>
        </StackPane>

        <VBox alignment="CENTER" spacing="5">
            <Text text="РЕГИСТРАЦИЯ"
                  style="-fx-font-family: 'Arial'; -fx-font-size: 24; -fx-font-weight: bold; -fx-fill: #212529; -fx-text-alignment: center;"
                  textAlignment="CENTER"/>
            <Text text="СОЗДАНИЕ АККАУНТА"
                  style="-fx-font-family: 'Arial'; -fx-font-size: 14; -fx-fill: #495057; -fx-text-alignment: center;"
                  textAlignment="CENTER"/>
        </VBox>
    </VBox>

    <!-- Форма регистрации - центрированные блоки -->
    <StackPane> <!-- Добавлен StackPane для центрирования -->
        <VBox alignment="CENTER" style="-fx-background-color: #ffffff; -fx-background-radius: 15; -fx-border-color: #dee2e6; -fx-border-width: 1; -fx-border-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 0, 1); -fx-max-width: 400; -fx-pref-width: 400; -fx-pref-height: 350;">
            <VBox alignment="CENTER" spacing="20" prefHeight="350" prefWidth="400" style="-fx-padding: 30;">
                <!-- Центрированный блок для логина -->
                <HBox alignment="CENTER"> <!-- Обертка для центрирования -->
                    <VBox alignment="CENTER" spacing="5">
                        <Label text="Логин:" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-text-fill: #495057;"/>
                        <TextField fx:id="usernameField" promptText="Введите логин"
                                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-pref-width: 300; -fx-pref-height: 40; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #ced4da; -fx-border-width: 1; -fx-text-fill: black; -fx-prompt-text-fill: #6c757d; -fx-alignment: center;"/>
                    </VBox>
                </HBox>

                <!-- Центрированный блок для пароля -->
                <HBox alignment="CENTER"> <!-- Обертка для центрирования -->
                    <VBox alignment="CENTER" spacing="5">
                        <Label text="Пароль:" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-text-fill: #495057;"/>
                        <PasswordField fx:id="passwordField" promptText="Введите пароль"
                                       style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-pref-width: 300; -fx-pref-height: 40; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #ced4da; -fx-border-width: 1; -fx-text-fill: black; -fx-prompt-text-fill: #6c757d; -fx-alignment: center;"/>
                    </VBox>
                </HBox>

                <!-- Центрированный блок для подтверждения пароля -->
                <HBox alignment="CENTER"> <!-- Обертка для центрирования -->
                    <VBox alignment="CENTER" spacing="5">
                        <Label text="Подтвердите пароль:" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-text-fill: #495057;"/>
                        <PasswordField fx:id="confirmPasswordField" promptText="Повторите пароль"
                                       style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-pref-width: 300; -fx-pref-height: 40; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #ced4da; -fx-border-width: 1; -fx-text-fill: black; -fx-prompt-text-fill: #6c757d; -fx-alignment: center;"/>
                    </VBox>
                </HBox>

                <!-- Центрированный блок для кнопки -->
                <HBox alignment="CENTER"> <!-- Обертка для центрирования -->
                    <VBox alignment="CENTER" spacing="10" style="-fx-padding: 10 0 0 0;">
                        <Button fx:id="registerButton" text="Создать аккаунт"
                                onMouseEntered="#handleMouseEnter"
                                onMouseExited="#handleMouseExit"
                                style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-font-weight: bold; -fx-min-width: 300; -fx-min-height: 45; -fx-pref-width: 300; -fx-pref-height: 45; -fx-max-width: 300; -fx-max-height: 45; -fx-background-color: #0d6efd; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand; -fx-alignment: center;"/>

                        <!-- Ссылка на вход -->
                        <HBox alignment="CENTER" spacing="5">
                            <Label text="Уже есть аккаунт?" alignment="CENTER"
                                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-text-fill: #495057; -fx-alignment: center;"/>
                            <Label text="Войти" alignment="CENTER"
                                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-text-fill: #0d6efd; -fx-font-weight: bold; -fx-cursor: hand; -fx-alignment: center;"
                                   onMouseClicked="#handleLoginRedirect"/>
                        </HBox>
                    </VBox>
                </HBox>
            </VBox>
        </VBox>
    </StackPane>

    <!-- Футер -->
    <VBox alignment="CENTER" spacing="5" style="-fx-padding: 20 0 0 0;">
        <Separator prefWidth="400" style="-fx-padding: 0 0 10 0;"/>
        <HBox alignment="CENTER" spacing="10">
            <Label text="© 2023 Property Appraisal System" alignment="CENTER"
                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12; -fx-text-fill: #6c757d; -fx-alignment: center;"/>
            <Label text="•" alignment="CENTER"
                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12; -fx-text-fill: #adb5bd; -fx-alignment: center;"/>
            <Label text="v1.0.0" alignment="CENTER"
                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12; -fx-text-fill: #adb5bd; -fx-alignment: center;"/>
        </HBox>
        <Label text="Техническая поддержка: support@example.com" alignment="CENTER"
               style="-fx-font-family: 'Segoe UI'; -fx-font-size: 11; -fx-text-fill: #6c757d; -fx-alignment: center;"/>
    </VBox>
</VBox>