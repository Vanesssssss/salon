<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.effect.InnerShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.LinearGradient?>
<?import javafx.scene.paint.Stop?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox fx:id="mainContainer" alignment="TOP_CENTER" spacing="20"
      style="-fx-padding: 25; -fx-background-color: linear-gradient(to bottom, #f0f4f8, #e2e8f0);"
      xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controllers.Employee.EmplInfoController">

    <!-- Заголовок с градиентом -->
    <StackPane>
        <Rectangle width="500" height="60" arcWidth="15" arcHeight="15">
            <fill>
                <LinearGradient startX="0" startY="0" endX="1" endY="0">
                    <stops>
                        <Stop offset="0.0" color="#0ea5e9"/>
                        <Stop offset="1.0" color="#10b981"/>
                    </stops>
                </LinearGradient>
            </fill>
            <effect>
                <DropShadow color="rgba(0,0,0,0.1)" radius="8" offsetX="0" offsetY="4"/>
            </effect>
        </Rectangle>
        <Text text="ЛИЧНАЯ ИНФОРМАЦИЯ"
              style="-fx-font-family: 'Segoe UI'; -fx-font-size: 24; -fx-font-weight: bold; -fx-fill: white;">
            <effect>
                <InnerShadow blurType="GAUSSIAN" color="rgba(0,0,0,0.15)" radius="1" offsetX="0" offsetY="1"/>
            </effect>
        </Text>
    </StackPane>

    <!-- Карточка с информацией -->
    <StackPane>
        <Rectangle width="700" height="350" arcWidth="20" arcHeight="20" fill="white">
            <effect>
                <DropShadow color="rgba(0,0,0,0.08)" radius="15" offsetX="0" offsetY="6"/>
            </effect>
        </Rectangle>

        <HBox alignment="CENTER" spacing="40" style="-fx-padding: 30;">
            <!-- Левая часть - метки -->
            <VBox alignment="CENTER_RIGHT" spacing="25" style="-fx-padding: 0 0 0 20;">
                <Label text="Логин:" style="-fx-font-family: 'Segoe UI Semibold'; -fx-font-size: 18; -fx-text-fill: #334155;">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Label>
                <Label text="Фамилия:" style="-fx-font-family: 'Segoe UI Semibold'; -fx-font-size: 18; -fx-text-fill: #334155;">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Label>
                <Label text="Имя:" style="-fx-font-family: 'Segoe UI Semibold'; -fx-font-size: 18; -fx-text-fill: #334155;">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Label>
                <Label text="Стаж:" style="-fx-font-family: 'Segoe UI Semibold'; -fx-font-size: 18; -fx-text-fill: #334155;">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Label>
                <Label text="Специализация:" style="-fx-font-family: 'Segoe UI Semibold'; -fx-font-size: 18; -fx-text-fill: #334155;">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Label>
            </VBox>

            <!-- Правая часть - значения -->
            <VBox alignment="CENTER_LEFT" spacing="25">
                <Label fx:id="loginLabel" text="-" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 18; -fx-text-fill: #1e293b;">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Label>
                <Label fx:id="lastNameLabel" text="-" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 18; -fx-text-fill: #1e293b;">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Label>
                <Label fx:id="firstNameLabel" text="-" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 18; -fx-text-fill: #1e293b;">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Label>
                <Label fx:id="experience_yearsLabel" text="-" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 18; -fx-text-fill: #1e293b;">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Label>
                <Label fx:id="specializationLabel" text="-" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 18; -fx-text-fill: #1e293b;">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Label>
            </VBox>
        </HBox>
    </StackPane>

    <!-- Кнопки действий -->
    <HBox alignment="CENTER" spacing="30" style="-fx-padding: 20 0 0 0;">
        <Button onAction="#handleUpdInfo" text="Изменить информацию"
                style="-fx-font-family: 'Segoe UI Semibold'; -fx-font-size: 16; -fx-min-width: 250; -fx-min-height: 45; -fx-background-color: #0ea5e9; -fx-text-fill: white; -fx-background-radius: 8;">
            <effect>
                <DropShadow color="rgba(14,165,233,0.3)" radius="8" offsetX="0" offsetY="4"/>
            </effect>
        </Button>

        <Button fx:id="backButton" onAction="#handleBack" text="Назад"
                style="-fx-font-family: 'Segoe UI Semibold'; -fx-font-size: 16; -fx-min-width: 180; -fx-min-height: 45; -fx-background-color: #64748b; -fx-text-fill: white; -fx-background-radius: 8;">
            <effect>
                <DropShadow color="rgba(100,116,139,0.3)" radius="6" offsetX="0" offsetY="3"/>
            </effect>
        </Button>
    </HBox>

    <!-- Футер -->
    <StackPane style="-fx-padding: 20 0 0 0;">
        <Rectangle width="600" height="40" arcWidth="20" arcHeight="20"
                   fill="linear-gradient(to right, #c7d2fe, #e0e7ff)">
            <effect>
                <DropShadow color="rgba(0,0,0,0.05)" radius="8" offsetX="0" offsetY="2"/>
            </effect>
        </Rectangle>
        <HBox alignment="CENTER" spacing="10">
            <Text text="Beauty Salon System" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-fill: #4f46e5;"/>
        </HBox>
    </StackPane>
</VBox>