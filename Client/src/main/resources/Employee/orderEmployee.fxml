<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.effect.InnerShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.LinearGradient?>
<?import javafx.scene.paint.Stop?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox fx:id="mainContainer" alignment="TOP_CENTER" spacing="20"
      xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controllers.Employee.OrderEmployeeController">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <!-- Заголовок с градиентом -->
    <StackPane>
        <Rectangle width="400" height="60" arcWidth="15" arcHeight="15">
            <fill>
                <LinearGradient startX="0" startY="0" endX="1" endY="0">
                    <stops>
                        <Stop offset="0.0" color="#0ea5e9"/>
                        <Stop offset="1.0" color="#10b981"/>
                    </stops>
                </LinearGradient>
            </fill>
            <effect>
                <DropShadow color="rgba(0,0,0,0.1)" radius="8" offsetX="0" offsetY="4"/>
            </effect>
        </Rectangle>
        <Text text="УПРАВЛЕНИЕ ЗАПИСЯМИ" fill="WHITE">
            <font>
                <Font name="Segoe UI" size="24"/>
            </font>
            <effect>
                <InnerShadow blurType="GAUSSIAN" color="rgba(0,0,0,0.15)" radius="1" offsetX="0" offsetY="1"/>
            </effect>
        </Text>
    </StackPane>

    <!-- Панель фильтров -->
    <StackPane>
        <Rectangle width="700" height="80" arcWidth="15" arcHeight="15" fill="WHITE">
            <effect>
                <DropShadow color="rgba(0,0,0,0.06)" radius="10" offsetX="0" offsetY="4"/>
            </effect>
        </Rectangle>

        <HBox alignment="CENTER" spacing="15">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>
            <children>
                <VBox spacing="5" alignment="CENTER_LEFT">
                    <Label text="Клиент:" textFill="#334155">
                        <font>
                            <Font name="Segoe UI Semibold" size="14"/>
                        </font>
                    </Label>
                    <TextField fx:id="employeeLastNameSearchField" onKeyReleased="#searchByEmployeeLastName"
                               prefHeight="36" prefWidth="200" promptText="Введите фамилию"/>
                </VBox>

                <VBox spacing="5" alignment="CENTER_LEFT">
                    <Label text="Диапазон цен:" textFill="#334155">
                        <font>
                            <Font name="Segoe UI Semibold" size="14"/>
                        </font>
                    </Label>
                    <HBox spacing="5" alignment="CENTER">
                        <TextField fx:id="priceFromField" prefHeight="36" prefWidth="80" promptText="От"/>
                        <Label text="—" textFill="#334155">
                            <font>
                                <Font name="Segoe UI Semibold" size="14"/>
                            </font>
                        </Label>
                        <TextField fx:id="priceToField" prefHeight="36" prefWidth="80" promptText="До"/>
                    </HBox>
                </VBox>

                <VBox spacing="5" alignment="CENTER">
                    <Button onAction="#applyFilters" text="Применить"
                            minWidth="120" minHeight="36" style="-fx-background-color: #6366f1; -fx-text-fill: white;">
                        <font>
                            <Font name="Segoe UI Semibold" size="14"/>
                        </font>
                        <effect>
                            <DropShadow color="rgba(99,102,241,0.3)" radius="6" offsetX="0" offsetY="3"/>
                        </effect>
                    </Button>
                </VBox>

                <VBox spacing="5" alignment="CENTER">
                    <Button onAction="#sortAppointmentsByDate" text="Сортировать"
                            minWidth="120" minHeight="36" style="-fx-background-color: #10b981; -fx-text-fill: white;">
                        <font>
                            <Font name="Segoe UI Semibold" size="14"/>
                        </font>
                        <effect>
                            <DropShadow color="rgba(16,185,129,0.3)" radius="6" offsetX="0" offsetY="3"/>
                        </effect>
                    </Button>
                </VBox>
            </children>
        </HBox>
    </StackPane>

    <!-- Таблица записей в белом контейнере -->
    <StackPane>
        <Rectangle width="750" height="300" arcWidth="15" arcHeight="15" fill="WHITE">
            <effect>
                <DropShadow color="rgba(0,0,0,0.08)" radius="12" offsetX="0" offsetY="6"/>
            </effect>
        </Rectangle>

        <TableView fx:id="appointmentsTable" prefHeight="300" prefWidth="750">
            <columns>
                <TableColumn fx:id="employeeLastNameColumn" text="Фамилия" prefWidth="100"/>
                <TableColumn fx:id="employeeFirstNameColumn" text="Имя" prefWidth="100"/>
                <TableColumn fx:id="numberNameColumn" text="Телефон" prefWidth="110"/>
                <TableColumn fx:id="serviceNameColumn" text="Услуга" prefWidth="150"/>
                <TableColumn fx:id="servicePriceColumn" text="Стоимость" prefWidth="80"/>
                <TableColumn fx:id="appointmentDateColumn" text="Дата" prefWidth="100"/>
                <TableColumn fx:id="appointmentTimeColumn" text="Время" prefWidth="80"/>
                <TableColumn fx:id="cancelAppointmentColumn" text="Статус" prefWidth="100"/>
            </columns>
        </TableView>
    </StackPane>

    <!-- Кнопка возврата -->
    <Button fx:id="backButton" onAction="#handleBack" text="Вернуться в меню"
            minWidth="200" minHeight="40" style="-fx-background-color: #64748b; -fx-text-fill: white;">
        <font>
            <Font name="Segoe UI Semibold" size="14"/>
        </font>
        <effect>
            <DropShadow color="rgba(100,116,139,0.3)" radius="6" offsetX="0" offsetY="3"/>
        </effect>
        <VBox.margin>
            <Insets top="10.0"/>
        </VBox.margin>
    </Button>

    <!-- Футер -->
    <VBox alignment="CENTER" spacing="5">
        <padding>
            <Insets top="20.0"/>
        </padding>
        <children>
            <HBox alignment="CENTER" spacing="10">
                <children>
                    <Label text="© 2023 Property Appraisal System" textFill="#64748b">
                        <font>
                            <Font name="Segoe UI" size="12"/>
                        </font>
                    </Label>
                    <Label text="•" textFill="#adb5bd">
                        <font>
                            <Font name="Segoe UI" size="12"/>
                        </font>
                    </Label>
                    <Label text="v1.0.0" textFill="#adb5bd">
                        <font>
                            <Font name="Segoe UI" size="12"/>
                        </font>
                    </Label>
                </children>
            </HBox>
            <Label text="Техническая поддержка: support@example.com" textFill="#6c757d">
                <font>
                    <Font name="Segoe UI" size="11"/>
                </font>
            </Label>
        </children>
    </VBox>
</VBox>