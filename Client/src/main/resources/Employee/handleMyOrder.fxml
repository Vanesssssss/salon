<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.LinearGradient?>
<?import javafx.scene.paint.Stop?>

<VBox fx:id="mainContainer" alignment="TOP_CENTER" fillWidth="false" prefHeight="600.0" prefWidth="800.0" spacing="20"
      style="-fx-padding: 20; -fx-background-color: linear-gradient(to bottom, #f0f4f8, #e2e8f0);"
      xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controllers.Сlient.HandleMyOrderController">

    <!-- Modern header with gradient and shadow -->
    <HBox alignment="CENTER" prefHeight="70.0" prefWidth="760.0"
          style="-fx-background-color: linear-gradient(to right, #0ea5e9, #10b981); -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 4);">
        <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: white;" text="Мои записи" />
    </HBox>

    <HBox alignment="CENTER" prefWidth="720" spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 6, 0, 0, 2);">
        <children>
            <TextField fx:id="employeeLastNameSearchField" onKeyReleased="#searchByEmployeeLastName"
                       prefHeight="36.0" prefWidth="200.0" promptText="Фамилия мастера"
                       style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-background-radius: 8;" />

            <HBox spacing="5" alignment="CENTER">
                <Label text="Цена от:" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-text-fill: #1e293b;" />
                <TextField fx:id="priceFromField" prefHeight="36.0" prefWidth="60.0" promptText="0"
                           style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-background-radius: 8;" />

                <Label text="до:" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-text-fill: #1e293b;" />
                <TextField fx:id="priceToField" prefHeight="36.0" prefWidth="60.0" promptText="9999"
                           style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-background-radius: 8;" />
            </HBox>

            <Button onAction="#applyFilters"
                    style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-color: #8b5cf6; -fx-text-fill: white; -fx-background-radius: 10; -fx-pref-height: 36; -fx-pref-width: 120;">
                <effect>
                    <DropShadow color="rgba(139,92,246,0.3)" radius="6" offsetX="0" offsetY="3"/>
                </effect>
                Фильтровать
            </Button>

            <Button onAction="#sortAppointmentsByDate"
                    style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-color: #0ea5e9; -fx-text-fill: white; -fx-background-radius: 10; -fx-pref-height: 36; -fx-pref-width: 160;">
                <effect>
                    <DropShadow color="rgba(14,165,233,0.3)" radius="6" offsetX="0" offsetY="3"/>
                </effect>
                Сортировать по дате
            </Button>
        </children>
    </HBox>

    <TableView fx:id="appointmentsTable" prefHeight="342.0" prefWidth="760.0"
               style="-fx-font-family: 'Segoe UI'; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 1);">
        <columns>
            <TableColumn fx:id="employeeLastNameColumn" text="Фамилия мастера" style="-fx-font-family: 'Segoe UI';" />
            <TableColumn fx:id="employeeFirstNameColumn" text="Имя мастера" style="-fx-font-family: 'Segoe UI';" />
            <TableColumn fx:id="serviceNameColumn" text="Услуга" style="-fx-font-family: 'Segoe UI';" />
            <TableColumn fx:id="servicePriceColumn" text="Стоимость" style="-fx-font-family: 'Segoe UI';" />
            <TableColumn fx:id="appointmentDateColumn" text="Дата" style="-fx-font-family: 'Segoe UI';" />
            <TableColumn fx:id="appointmentTimeColumn" text="Время" style="-fx-font-family: 'Segoe UI';" />
            <TableColumn fx:id="cancelAppointmentColumn" prefWidth="123.19998168945312" text="Статус записи" style="-fx-font-family: 'Segoe UI';" />
        </columns>
    </TableView>

    <Button fx:id="backButton" onAction="#handleBack"
            onMouseEntered="#handleMouseEnterExit" onMouseExited="#handleMouseExitExit"
            style="-fx-background-radius: 10; -fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-font-weight: bold; -fx-background-color: #64748b; -fx-text-fill: white; -fx-pref-height: 40; -fx-pref-width: 150;">
        <effect>
            <DropShadow color="rgba(100,116,139,0.3)" radius="6" offsetX="0" offsetY="3"/>
        </effect>
        Назад
    </Button>
</VBox>