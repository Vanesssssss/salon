<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.paint.LinearGradient?>
<?import javafx.scene.paint.Stop?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.shape.Circle?>

<VBox fx:id="mainContainer" alignment="TOP_CENTER" spacing="20"
      style="-fx-padding: 25; -fx-background-color: linear-gradient(to bottom, #f0f4f8, #e2e8f0);"
      xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controllers.Admin.UpdateServiceController">

    <!-- Заголовок -->
    <VBox alignment="CENTER" spacing="10">
        <children>
            <StackPane>
                <children>
                    <Rectangle width="500" height="60" arcWidth="15" arcHeight="15">
                        <fill>
                            <LinearGradient startX="0" startY="0" endX="1" endY="0">
                                <stops>
                                    <Stop offset="0.0" color="#4f46e5"/>
                                    <Stop offset="1.0" color="#7c3aed"/>
                                </stops>
                            </LinearGradient>
                        </fill>
                        <effect>
                            <DropShadow color="rgba(0,0,0,0.1)" radius="8" offsetX="0" offsetY="4"/>
                        </effect>
                    </Rectangle>
                    <VBox alignment="CENTER" spacing="5">
                        <children>
                            <Text text="ИЗМЕНЕНИЕ ОБЪЕКТА"
                                  style="-fx-font-family: 'Segoe UI'; -fx-font-size: 24; -fx-font-weight: bold; -fx-fill: white;">
                                <effect>
                                    <DropShadow color="#c7d2fe" radius="1" offsetX="0" offsetY="1"/>
                                </effect>
                            </Text>
                            <Text text="SERVICE UPDATE"
                                  style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-fill: #e0e7ff;"/>
                        </children>
                    </VBox>
                </children>
            </StackPane>
        </children>
    </VBox>

    <!-- Основной контент -->
    <StackPane prefWidth="600" prefHeight="500">
        <children>
            <!-- Фон формы -->
            <Rectangle width="600" height="450" arcWidth="20" arcHeight="20" fill="white">
                <effect>
                    <DropShadow color="rgba(0,0,0,0.08)" radius="15" offsetX="0" offsetY="8"/>
                </effect>
            </Rectangle>

            <!-- Декоративные элементы -->
            <Circle centerX="300" centerY="100" radius="80" fill="rgba(199,210,254,0.15)" />
            <Circle centerX="500" centerY="350" radius="60" fill="rgba(224,231,255,0.15)"/>

            <!-- Форма -->
            <VBox alignment="TOP_CENTER" spacing="20" style="-fx-padding: 30;">
                <!-- Выбор услуги -->
                <GridPane alignment="CENTER" hgap="10" vgap="15" style="-fx-padding: 0 0 10 0;">
                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" prefWidth="150"/>
                        <ColumnConstraints halignment="LEFT" prefWidth="350"/>
                    </columnConstraints>

                    <Label text="Выберите объект:"
                           style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-text-fill: #475569;"
                           GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <ComboBox fx:id="serviceComboBox" prefWidth="350" prefHeight="40"
                              style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-background-radius: 8;"
                              GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="Название объекта:"
                           style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-text-fill: #475569;"
                           GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="serviceName" prefWidth="350" prefHeight="40"
                               style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-background-radius: 8;"
                               GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Описание объекта:"
                           style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-text-fill: #475569;"
                           GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <TextArea fx:id="serviceDescription" prefWidth="350" prefHeight="100"
                              style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-background-radius: 8;"
                              GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                    <Label text="Цена посещения:"
                           style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-text-fill: #475569;"
                           GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <TextField fx:id="servicePrice" prefWidth="350" prefHeight="40"
                               style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-background-radius: 8;"
                               GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                    <Label text="Длительность посещения:"
                           style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-text-fill: #475569;"
                           GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                    <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="4">
                        <ComboBox fx:id="durationValue" prefWidth="150" prefHeight="40"
                                  promptText="Значение"
                                  style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-background-radius: 8;"/>
                        <ComboBox fx:id="durationUnit" prefWidth="190" prefHeight="40"
                                  promptText="Единицы"
                                  style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-background-radius: 8;"/>
                    </HBox>
                </GridPane>

                <!-- Кнопки -->
                <HBox alignment="CENTER" spacing="20" style="-fx-padding: 20 0 0 0;">
                    <Button fx:id="updateServiceButton" text="Изменить услугу"
                            style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-font-weight: bold; -fx-min-width: 220; -fx-min-height: 45; -fx-background-color: #4f46e5; -fx-text-fill: white; -fx-background-radius: 10;">
                        <effect>
                            <DropShadow color="rgba(79,70,229,0.3)" radius="8" offsetX="0" offsetY="4"/>
                        </effect>
                    </Button>

                    <Button fx:id="backButton" text="Назад"
                            style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-font-weight: bold; -fx-min-width: 180; -fx-min-height: 45; -fx-background-color: #64748b; -fx-text-fill: white; -fx-background-radius: 10;">
                        <effect>
                            <DropShadow color="rgba(100,116,139,0.3)" radius="6" offsetX="0" offsetY="3"/>
                        </effect>
                    </Button>
                </HBox>
            </VBox>
        </children>
    </StackPane>

    <!-- Футер -->
    <VBox alignment="CENTER" spacing="5" style="-fx-padding: 20 0 0 0;">
        <children>
            <HBox alignment="CENTER" spacing="10">
                <children>
                    <Label text="© 2023 Hair Salon System"
                           style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12; -fx-text-fill: #64748b;"/>
                    <Label text="•"
                           style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12; -fx-text-fill: #adb5bd;"/>
                    <Label text="v1.0.0"
                           style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12; -fx-text-fill: #adb5bd;"/>
                </children>
            </HBox>
            <Label text="Техническая поддержка: support@example.com"
                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 11; -fx-text-fill: #6c757d;"/>
        </children>
    </VBox>
</VBox>