<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.LinearGradient?>
<?import javafx.scene.paint.Stop?>

<VBox fx:id="mainContainer" alignment="TOP_CENTER" fillWidth="false" prefHeight="550.0" prefWidth="800.0" spacing="20"
      style="-fx-padding: 20; -fx-background-color: linear-gradient(to bottom, #f0f4f8, #e2e8f0);"
      xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controllers.Сlient.AddClientOrderController">

    <!-- Modern header with gradient and shadow -->
    <HBox alignment="CENTER" prefHeight="70.0" prefWidth="760.0"
          style="-fx-background-color: linear-gradient(to right, #0ea5e9, #10b981); -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 4);">
        <Label alignment="CENTER" prefHeight="42.0" prefWidth="760.0"
               style="-fx-font-family: 'Segoe UI'; -fx-font-size: 32; -fx-font-weight: bold;"
               text="Записаться на услугу" textFill="white" />
    </HBox>

    <AnchorPane prefHeight="549.0" prefWidth="746.0">
        <children>
            <VBox alignment="CENTER" layoutX="298.0" prefHeight="408.0" prefWidth="447.0"
                  style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 3);">
                <children>
                    <!-- Комбо для выбора мастера -->
                    <HBox alignment="CENTER" spacing="10">
                        <Label style="-fx-font-size: 16; -fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Выберите мастера:" />
                        <ComboBox fx:id="masterComboBox" prefWidth="200" style="-fx-font-family: 'Segoe UI';" />
                        <VBox.margin><Insets bottom="15.0" top="20.0" /></VBox.margin>
                    </HBox>

                    <!-- Комбо для выбора услуги -->
                    <HBox alignment="CENTER" spacing="10">
                        <Label style="-fx-font-size: 16; -fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Выберите услугу:" />
                        <ComboBox fx:id="serviceComboBox" prefWidth="200" style="-fx-font-family: 'Segoe UI';" />
                        <VBox.margin><Insets bottom="15.0" /></VBox.margin>
                    </HBox>

                    <!-- Комбо для выбора даты -->
                    <HBox alignment="CENTER" spacing="10">
                        <Label prefHeight="46.0" prefWidth="115.0" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Выберите дату:" />
                        <DatePicker fx:id="datePicker" prefWidth="200" style="-fx-font-family: 'Segoe UI';" />
                        <VBox.margin><Insets bottom="15.0" /></VBox.margin>
                    </HBox>

                    <!-- Комбо для выбора времени -->
                    <HBox alignment="TOP_CENTER" prefHeight="44.0" prefWidth="447.0" spacing="10">
                        <Label style="-fx-font-size: 16; -fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Выберите время:" />
                        <ComboBox fx:id="timeComboBox" prefWidth="200" style="-fx-font-family: 'Segoe UI';" />
                        <VBox.margin><Insets bottom="20.0" /></VBox.margin>
                    </HBox>

                    <Button onAction="#handleMyOrder"
                            style="-fx-font-size: 16; -fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-background-color: #0ea5e9; -fx-text-fill: white; -fx-background-radius: 10; -fx-pref-height: 40; -fx-pref-width: 160;">
                        <effect>
                            <DropShadow color="rgba(14,165,233,0.3)" radius="6" offsetX="0" offsetY="3"/>
                        </effect>
                        Мои записи
                    </Button>
                </children>
            </VBox>

            <!-- Кнопка для подтверждения записи -->
            <Button layoutX="24.0" layoutY="245.0" onAction="#saveAppointment"
                    style="-fx-font-size: 16; -fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-background-color: #8b5cf6; -fx-text-fill: white; -fx-background-radius: 10; -fx-pref-height: 50; -fx-pref-width: 220;">
                <effect>
                    <DropShadow color="rgba(139,92,246,0.3)" radius="8" offsetX="0" offsetY="4"/>
                </effect>
                Записаться
            </Button>

            <Button fx:id="backButton" layoutX="69.0" layoutY="328.0" onAction="#handleBack"
                    onMouseEntered="#handleMouseEnterExit" onMouseExited="#handleMouseExitExit"
                    style="-fx-background-radius: 10; -fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-font-weight: bold; -fx-background-color: #64748b; -fx-text-fill: white; -fx-pref-height: 40; -fx-pref-width: 150;">
                <effect>
                    <DropShadow color="rgba(100,116,139,0.3)" radius="6" offsetX="0" offsetY="3"/>
                </effect>
                Назад
            </Button>
        </children>
    </AnchorPane>
</VBox>