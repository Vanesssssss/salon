<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.paint.LinearGradient?>
<?import javafx.scene.paint.Stop?>

<VBox fx:id="mainContainer" alignment="TOP_CENTER" fillWidth="false" spacing="20"
      style="-fx-padding: 25; -fx-background-color: linear-gradient(to bottom, #f0f4f8, #e2e8f0);"
      xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controllers.Сlient.AddServiceControllerCl">

    <!-- Заголовок с тенью и градиентом -->
    <StackPane>
        <Rectangle width="450" height="60" arcWidth="15" arcHeight="15">
            <fill>
                <LinearGradient startX="0" startY="0" endX="1" endY="0">
                    <stops>
                        <Stop offset="0.0" color="#4f46e5"/>
                        <Stop offset="1.0" color="#7c3aed"/>
                    </stops>
                </LinearGradient>
            </fill>
            <effect>
                <DropShadow color="rgba(0,0,0,0.1)" radius="8" offsetX="0" offsetY="4"/>
            </effect>
        </Rectangle>
        <Text text="ДОБАВЛЕНИЕ ОБЪЕКТА"
              style="-fx-font-family: 'Segoe UI'; -fx-font-size: 24; -fx-font-weight: bold; -fx-fill: white;">
            <effect>
                <DropShadow color="#c7d2fe" radius="1" offsetX="0" offsetY="1"/>
            </effect>
        </Text>
    </StackPane>

    <!-- Основной контейнер с закругленными углами -->
    <StackPane>
        <Rectangle width="550" height="550" arcWidth="25" arcHeight="25" fill="white">
            <effect>
                <DropShadow color="rgba(0,0,0,0.08)" radius="15" offsetX="0" offsetY="8"/>
            </effect>
        </Rectangle>

        <VBox alignment="TOP_CENTER" fillWidth="false" spacing="15" style="-fx-padding: 30;">
            <!-- Название услуги -->
            <Label text="Название объекта:"
                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-text-fill: #475569;"/>
            <TextField fx:id="serviceName" maxWidth="400.0" minWidth="300.0" prefHeight="40.0" prefWidth="400.0"
                       promptText="Введите название"
                       style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #cbd5e1; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 3, 0, 0, 1);"/>

            <!-- Описание услуги -->
            <Label text="Описание объекта:"
                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-text-fill: #475569;"/>
            <TextArea fx:id="serviceDescription" maxWidth="400.0" minWidth="300.0" prefHeight="100.0" prefWidth="400.0"
                      promptText="Введите описание"
                      style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #cbd5e1; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 3, 0, 0, 1);"/>

            <!-- Цена услуги -->
            <Label text="Цена посещения:"
                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-text-fill: #475569;"/>
            <TextField fx:id="servicePrice" maxWidth="400.0" minWidth="300.0" prefHeight="40.0" prefWidth="400.0"
                       promptText="Введите цену"
                       style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #cbd5e1; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 3, 0, 0, 1);"/>

            <!-- Продолжительность -->
            <Label text="Продолжительность посещения:"
                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-text-fill: #475569;"/>
            <HBox alignment="CENTER" spacing="15">
                <ComboBox fx:id="durationValue" prefHeight="40.0" prefWidth="180.0"
                          promptText="Число (1-60)"
                          style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #cbd5e1; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 3, 0, 0, 1);"/>

                <ComboBox fx:id="durationUnit" prefHeight="40.0" prefWidth="180.0"
                          promptText="Единица измерения"
                          style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #cbd5e1; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 3, 0, 0, 1);"/>
            </HBox>

            <!-- Кнопки -->
            <HBox alignment="CENTER" spacing="30" style="-fx-padding: 20 0 0 0;">
                <Button fx:id="addServiceButton" onMouseEntered="#handleMouseEnter" onMouseExited="#handleMouseExit"
                        text="Добавить объект"
                        style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-font-weight: bold; -fx-min-width: 200; -fx-min-height: 45; -fx-background-color: #4f46e5; -fx-text-fill: white; -fx-background-radius: 10;">
                    <effect>
                        <DropShadow color="rgba(79,70,229,0.3)" radius="8" offsetX="0" offsetY="4"/>
                    </effect>
                </Button>

                <Button fx:id="backButton" onAction="#handleBack" onMouseEntered="#handleMouseEnterExit" onMouseExited="#handleMouseExitExit"
                        text="Назад"
                        style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-font-weight: bold; -fx-min-width: 180; -fx-min-height: 45; -fx-background-color: #64748b; -fx-text-fill: white; -fx-background-radius: 10;">
                    <effect>
                        <DropShadow color="rgba(100,116,139,0.3)" radius="6" offsetX="0" offsetY="3"/>
                    </effect>
                </Button>
            </HBox>
        </VBox>
    </StackPane>

    <!-- Футер -->
    <VBox alignment="CENTER" spacing="5" style="-fx-padding: 20 0 0 0;">
        <Label text="© 2023 Property Appraisal System"
               style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12; -fx-text-fill: #64748b;"/>
    </VBox>
</VBox>