<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.LinearGradient?>
<?import javafx.scene.paint.Stop?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Text?>

<VBox alignment="TOP_CENTER" prefHeight="600.0" prefWidth="800.0" spacing="20"
      style="-fx-padding: 25; -fx-background-color: linear-gradient(to bottom, #f0f4f8, #e2e8f0);"
      xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controllers.Сlient.ClMasterController">

    <!-- Modern header with gradient and shadow -->
    <StackPane>
        <Rectangle width="450" height="60" arcWidth="15" arcHeight="15">
            <fill>
                <LinearGradient startX="0" startY="0" endX="1" endY="0">
                    <stops>
                        <Stop offset="0.0" color="#0ea5e9"/>
                        <Stop offset="1.0" color="#10b981"/>
                    </stops>
                </LinearGradient>
            </fill>
            <effect>
                <DropShadow color="rgba(0,0,0,0.1)" radius="8" offsetX="0" offsetY="4"/>
            </effect>
        </Rectangle>
        <VBox alignment="CENTER" spacing="5">
            <Text text="МАСТЕРА"
                  style="-fx-font-family: 'Segoe UI'; -fx-font-size: 24; -fx-font-weight: bold; -fx-fill: white;">
                <effect>
                    <DropShadow color="#c7d2fe" radius="1" offsetX="0" offsetY="1"/>
                </effect>
            </Text>
            <Text text="OUR SPECIALISTS"
                  style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-fill: #e0e7ff;"/>
        </VBox>
    </StackPane>

    <!-- Search and filter panel -->
    <VBox alignment="CENTER" spacing="10" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 12, 0, 0, 3);">
        <!-- Search -->
        <HBox alignment="CENTER" spacing="10">
            <Label text="Поиск:"
                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
            <TextField fx:id="searchField" prefHeight="36.0" prefWidth="250.0"
                       promptText="Специализация" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-background-radius: 8;"/>
        </HBox>

        <!-- Filter and sort -->
        <HBox alignment="CENTER" spacing="15">
            <HBox alignment="CENTER" spacing="5">
                <Label text="Стаж работы:"
                       style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                <TextField fx:id="minExpField" prefHeight="36.0" prefWidth="60.0"
                           promptText="От" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-background-radius: 8;"/>
                <Label text="-"
                       style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-text-fill: #1e293b;"/>
                <TextField fx:id="maxExpField" prefHeight="36.0" prefWidth="60.0"
                           promptText="До" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-background-radius: 8;"/>
                <Button fx:id="filterButton" onAction="#applyFilter"
                        style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-font-weight: bold; -fx-min-width: 120; -fx-min-height: 36; -fx-background-color: #8b5cf6; -fx-text-fill: white; -fx-background-radius: 10;">
                    <effect>
                        <DropShadow color="rgba(139,92,246,0.3)" radius="8" offsetX="0" offsetY="4"/>
                    </effect>
                    Применить
                </Button>
            </HBox>

            <HBox alignment="CENTER" spacing="5">
                <Label text="Сортировка:"
                       style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                <ComboBox fx:id="sortComboBox" prefHeight="36.0" prefWidth="150.0"
                          style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-background-radius: 8;"/>
                <Button fx:id="sortButton" onAction="#applySort"
                        style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-font-weight: bold; -fx-min-width: 120; -fx-min-height: 36; -fx-background-color: #0ea5e9; -fx-text-fill: white; -fx-background-radius: 10;">
                    <effect>
                        <DropShadow color="rgba(14,165,233,0.3)" radius="8" offsetX="0" offsetY="4"/>
                    </effect>
                    Сортировать
                </Button>
            </HBox>
        </HBox>
    </VBox>

    <!-- Masters container -->
    <FlowPane fx:id="mastersFlowPane" hgap="20" prefHeight="400.0" prefWidth="780.0"
              style="-fx-padding: 10;" vgap="20" />

    <!-- Back button -->
    <Button fx:id="backButton" onAction="#handleBack"
            onMouseEntered="#handleMouseEnterExit" onMouseExited="#handleMouseExitExit"
            style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-font-weight: bold; -fx-min-width: 150; -fx-min-height: 45; -fx-background-color: #64748b; -fx-text-fill: white; -fx-background-radius: 10;">
        <effect>
            <DropShadow color="rgba(100,116,139,0.3)" radius="6" offsetX="0" offsetY="3"/>
        </effect>
        Назад
        <VBox.margin>
            <Insets top="10" bottom="20"/>
        </VBox.margin>
    </Button>

    <!-- Footer -->
    <VBox alignment="CENTER" spacing="5" style="-fx-padding: 20 0 0 0;">
        <HBox alignment="CENTER" spacing="10">
            <Label text="© 2023 Property Appraisal System"
                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12; -fx-text-fill: #64748b;"/>
            <Label text="•"
                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12; -fx-text-fill: #adb5bd;"/>
            <Label text="v1.0.0"
                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12; -fx-text-fill: #adb5bd;"/>
        </HBox>
        <Label text="Техническая поддержка: support@example.com"
               style="-fx-font-family: 'Segoe UI'; -fx-font-size: 11; -fx-text-fill: #6c757d;"/>
    </VBox>
</VBox>