<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.paint.LinearGradient?>
<?import javafx.scene.paint.Stop?>

<VBox fx:id="mainContainer" alignment="TOP_CENTER" spacing="20"
      style="-fx-padding: 25; -fx-background-color: linear-gradient(to bottom, #f0f4f8, #e2e8f0);"
      xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controllers.Admin.AddSerMasController">

    <!-- Заголовок -->
    <VBox alignment="CENTER" spacing="10">
        <children>
            <StackPane>
                <children>
                    <Rectangle width="500" height="60" arcWidth="15" arcHeight="15">
                        <fill>
                            <LinearGradient startX="0" startY="0" endX="1" endY="0">
                                <stops>
                                    <Stop offset="0.0" color="#8b5cf6"/>
                                    <Stop offset="1.0" color="#7c3aed"/>
                                </stops>
                            </LinearGradient>
                        </fill>
                        <effect>
                            <DropShadow color="rgba(0,0,0,0.1)" radius="8" offsetX="0" offsetY="4"/>
                        </effect>
                    </Rectangle>
                    <VBox alignment="CENTER" spacing="5">
                        <children>
                            <Text text="ПРИВЯЗКА УСЛУГ К МАСТЕРУ"
                                  style="-fx-font-family: 'Segoe UI'; -fx-font-size: 24; -fx-font-weight: bold; -fx-fill: white;">
                                <effect>
                                    <DropShadow color="#ddd6fe" radius="1" offsetX="0" offsetY="1"/>
                                </effect>
                            </Text>
                            <Text text="SERVICE ASSIGNMENT"
                                  style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-fill: #e9d5ff;"/>
                        </children>
                    </VBox>
                </children>
            </StackPane>
        </children>
    </VBox>

    <!-- Основной контент -->
    <VBox alignment="CENTER" spacing="20" style="-fx-padding: 20; -fx-max-width: 600;">
        <!-- Выбор мастера -->
        <ComboBox fx:id="masterComboBox" prefHeight="45.0" prefWidth="600.0"
                  promptText="Выберите риелтора"
                  style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-background-radius: 10; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
            <padding>
                <Insets left="15" right="15"/>
            </padding>
        </ComboBox>

        <!-- Область услуг -->
        <StackPane prefWidth="600" prefHeight="300">
            <children>
                <!-- Фон для списка услуг -->
                <Rectangle width="600" height="300" arcWidth="20" arcHeight="20" fill="white">
                    <effect>
                        <DropShadow color="rgba(0,0,0,0.08)" radius="15" offsetX="0" offsetY="8"/>
                    </effect>
                </Rectangle>

                <!-- Список чекбоксов для услуг -->
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" style="-fx-background: transparent; -fx-background-color: transparent;">
                    <content>
                        <VBox fx:id="servicesList" alignment="TOP_CENTER" spacing="10" style="-fx-padding: 20;"/>
                    </content>
                </ScrollPane>
            </children>
        </StackPane>

        <!-- Кнопки -->
        <HBox alignment="CENTER" spacing="20" style="-fx-padding: 20 0 0 0;">
            <Button fx:id="saveButton" text="Сохранить" onAction="#saveMasterServices"
                    style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-font-weight: bold; -fx-min-width: 180; -fx-min-height: 45; -fx-background-color: #8b5cf6; -fx-text-fill: white; -fx-background-radius: 10;">
                <effect>
                    <DropShadow color="rgba(139,92,246,0.3)" radius="8" offsetX="0" offsetY="4"/>
                </effect>
            </Button>

            <Button fx:id="backButton" text="Назад" onAction="#handleBack"
                    style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-font-weight: bold; -fx-min-width: 180; -fx-min-height: 45; -fx-background-color: #64748b; -fx-text-fill: white; -fx-background-radius: 10;">
                <effect>
                    <DropShadow color="rgba(100,116,139,0.3)" radius="6" offsetX="0" offsetY="3"/>
                </effect>
            </Button>
        </HBox>
    </VBox>

    <!-- Футер -->
    <VBox alignment="CENTER" spacing="5" style="-fx-padding: 20 0 0 0;">
        <children>
            <HBox alignment="CENTER" spacing="10">
                <children>
                    <Label text="© 2023 Hair Salon System"
                           style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12; -fx-text-fill: #64748b;"/>
                    <Label text="•"
                           style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12; -fx-text-fill: #adb5bd;"/>
                    <Label text="v1.0.0"
                           style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12; -fx-text-fill: #adb5bd;"/>
                </children>
            </HBox>
            <Label text="Техническая поддержка: support@example.com"
                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 11; -fx-text-fill: #6c757d;"/>
        </children>
    </VBox>
</VBox>