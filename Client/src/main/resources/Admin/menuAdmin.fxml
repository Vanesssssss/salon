<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.paint.LinearGradient?>
<?import javafx.scene.paint.Stop?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<VBox fx:id="mainContainer" alignment="TOP_CENTER" spacing="20"
      style="-fx-padding: 25; -fx-background-color: linear-gradient(to bottom, #f0f4f8, #e2e8f0);"
      xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controllers.Admin.MenuAdminController">

    <children>
        <!-- Заголовок с тенью и градиентом (прежний размер) -->
        <VBox alignment="CENTER" spacing="10">
            <children>
                <StackPane>
                    <children>
                        <Rectangle width="450" height="60" arcWidth="15" arcHeight="15">
                            <fill>
                                <LinearGradient startX="0" startY="0" endX="1" endY="0">
                                    <stops>
                                        <Stop offset="0.0" color="#4f46e5"/>
                                        <Stop offset="1.0" color="#7c3aed"/>
                                    </stops>
                                </LinearGradient>
                            </fill>
                            <effect>
                                <DropShadow color="rgba(0,0,0,0.1)" radius="8" offsetX="0" offsetY="4"/>
                            </effect>
                        </Rectangle>
                        <VBox alignment="CENTER" spacing="5">
                            <children>
                                <Text text="АДМИНИСТРАТИВНАЯ ПАНЕЛЬ"
                                      style="-fx-font-family: 'Segoe UI'; -fx-font-size: 24; -fx-font-weight: bold; -fx-fill: white;">
                                    <effect>
                                        <DropShadow color="#c7d2fe" radius="1" offsetX="0" offsetY="1"/>
                                    </effect>
                                </Text>
                                <Text text="ADMINISTRATOR DASHBOARD"
                                      style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-fill: #e0e7ff;"/>
                            </children>
                        </VBox>
                    </children>
                </StackPane>
            </children>
        </VBox>

        <!-- Основной контент - УВЕЛИЧЕННЫЙ блок административной панели -->
        <HBox alignment="CENTER" spacing="50" style="-fx-padding: 25;">
            <children>
                <!-- Графические элементы: административная панель -->
                <VBox alignment="CENTER" spacing="25" prefWidth="400">
                    <children>
                        <!-- Иконка администратора -->
                        <StackPane>
                            <children>
                                <Circle radius="70" fill="white">
                                    <effect>
                                        <DropShadow color="rgba(0,0,0,0.1)" radius="12" offsetX="0" offsetY="5"/>
                                    </effect>
                                </Circle>
                                <StackPane>
                                    <children>
                                        <Circle radius="50" fill="#4f46e5"/>
                                        <Text text="A" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 36; -fx-font-weight: bold; -fx-fill: white;"/>
                                    </children>
                                </StackPane>
                            </children>
                        </StackPane>

                        <!-- Карточки статистики -->
                        <GridPane alignment="CENTER" hgap="15" vgap="15">
                            <columnConstraints>
                                <ColumnConstraints prefWidth="130"/>
                                <ColumnConstraints prefWidth="130"/>
                            </columnConstraints>
                            <children>
                                <!-- Карточка пользователей -->
                                <StackPane style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 12, 0, 0, 3);"
                                           GridPane.columnIndex="0">
                                    <children>
                                        <VBox alignment="CENTER" spacing="5">
                                            <children>
                                                <Circle radius="25" fill="#e0f2fe">
                                                    <effect>
                                                        <DropShadow color="#bae6fd" radius="6" spread="0.3"/>
                                                    </effect>
                                                </Circle>
                                                <Text text="124" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 26; -fx-font-weight: bold; -fx-fill: #0369a1;"/>
                                                <Text text="Пользователи" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13; -fx-fill: #64748b;"/>
                                            </children>
                                        </VBox>
                                    </children>
                                </StackPane>

                                <!-- Карточка оценок -->
                                <StackPane style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 12, 0, 0, 3);"
                                           GridPane.columnIndex="1">
                                    <children>
                                        <VBox alignment="CENTER" spacing="5">
                                            <children>
                                                <Circle radius="25" fill="#ede9fe">
                                                    <effect>
                                                        <DropShadow color="#ddd6fe" radius="6" spread="0.3"/>
                                                    </effect>
                                                </Circle>
                                                <Text text="358" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 26; -fx-font-weight: bold; -fx-fill: #7e22ce;"/>
                                                <Text text="Оценок" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13; -fx-fill: #64748b;"/>
                                            </children>
                                        </VBox>
                                    </children>
                                </StackPane>

                                <!-- Карточка активности -->
                                <StackPane style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 12, 0, 0, 3);"
                                           GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
                                    <children>
                                        <VBox alignment="CENTER" spacing="5">
                                            <children>
                                                <HBox alignment="CENTER" spacing="8">
                                                    <children>
                                                        <Circle radius="10" fill="#10b981"/>
                                                        <Circle radius="10" fill="#f59e0b"/>
                                                        <Circle radius="10" fill="#ef4444"/>
                                                    </children>
                                                </HBox>
                                                <Text text="Активность системы" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 15; -fx-font-weight: bold; -fx-fill: #475569;"/>
                                                <Text text="12 новых событий" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13; -fx-fill: #94a3b8;"/>
                                            </children>
                                        </VBox>
                                    </children>
                                </StackPane>
                            </children>
                        </GridPane>
                    </children>
                </VBox>

                <!-- Область с кнопками управления и декоративным фоном -->
                <StackPane prefWidth="450">
                    <!-- Декоративный фон для кнопок -->
                    <children>
                        <!-- Основной фон с градиентом -->
                        <Rectangle width="450" height="380" arcWidth="25" arcHeight="25" fill="#ffffff">
                            <effect>
                                <DropShadow color="rgba(0,0,0,0.08)" radius="15" offsetX="0" offsetY="8"/>
                            </effect>
                        </Rectangle>

                        <!-- Абстрактные декоративные элементы -->
                        <SVGPath fill="rgba(199,210,254,0.15)" content="M80,80 Q180,40 280,80 T450,80" stroke="transparent" strokeWidth="0"/>
                        <SVGPath fill="rgba(219,234,254,0.25)" content="M30,280 Q130,230 230,280 T430,280" stroke="transparent" strokeWidth="0"/>
                        <Circle centerX="380" centerY="80" radius="70" fill="rgba(238,242,255,0.25)"/>
                        <Circle centerX="80" centerY="320" radius="50" fill="rgba(224,231,255,0.15)"/>

                        <!-- Кнопки управления -->
                        <GridPane alignment="CENTER" hgap="15" vgap="15">
                            <columnConstraints>
                                <ColumnConstraints halignment="CENTER" hgrow="ALWAYS" minWidth="180" maxWidth="180"/>
                                <ColumnConstraints halignment="CENTER" hgrow="ALWAYS" minWidth="180" maxWidth="180"/>
                            </columnConstraints>
                            <children>
                                <!-- Услуги -->
                                <Button fx:id="service" text="Объекты" onAction="#handleService"
                                        style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-font-weight: bold; -fx-min-width: 180; -fx-min-height: 50; -fx-background-color: #4f46e5; -fx-text-fill: white; -fx-background-radius: 10;"
                                        onMouseEntered="#handleMouseEnter" onMouseExited="#handleMouseExit"
                                        GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <effect>
                                        <DropShadow color="rgba(79,70,229,0.3)" radius="8" offsetX="0" offsetY="4"/>
                                    </effect>
                                </Button>

                                <!-- Расписание -->
                                <Button fx:id="schedule" text="Расписание" onAction="#handleSchedule"
                                        style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-font-weight: bold; -fx-min-width: 180; -fx-min-height: 50; -fx-background-color: #7c3aed; -fx-text-fill: white; -fx-background-radius: 10;"
                                        onMouseEntered="#handleMouseEnter" onMouseExited="#handleMouseExit"
                                        GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <effect>
                                        <DropShadow color="rgba(124,58,237,0.3)" radius="8" offsetX="0" offsetY="4"/>
                                    </effect>
                                </Button>

                                <!-- Пользователи -->
                                <Button fx:id="user" text="Пользователи" onAction="#handleUser"
                                        style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-font-weight: bold; -fx-min-width: 180; -fx-min-height: 50; -fx-background-color: #0ea5e9; -fx-text-fill: white; -fx-background-radius: 10;"
                                        onMouseEntered="#handleMouseEnter" onMouseExited="#handleMouseExit"
                                        GridPane.columnIndex="0" GridPane.rowIndex="1">
                                    <effect>
                                        <DropShadow color="rgba(14,165,233,0.3)" radius="8" offsetX="0" offsetY="4"/>
                                    </effect>
                                </Button>

                                <!-- Отзывы -->
                                <Button fx:id="reviews" text="Отзывы" onAction="#handleReviews"
                                        style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-font-weight: bold; -fx-min-width: 180; -fx-min-height: 50; -fx-background-color: #8b5cf6; -fx-text-fill: white; -fx-background-radius: 10;"
                                        onMouseEntered="#handleMouseEnter" onMouseExited="#handleMouseExit"
                                        GridPane.columnIndex="1" GridPane.rowIndex="1">
                                    <effect>
                                        <DropShadow color="rgba(139,92,246,0.3)" radius="8" offsetX="0" offsetY="4"/>
                                    </effect>
                                </Button>

                                <!-- Записи -->
                                <Button fx:id="order" text="Записи" onAction="#handleOrder"
                                        style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-font-weight: bold; -fx-min-width: 380; -fx-min-height: 50; -fx-background-color: #6366f1; -fx-text-fill: white; -fx-background-radius: 10;"
                                        onMouseEntered="#handleMouseEnter" onMouseExited="#handleMouseExit"
                                        GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2">
                                    <effect>
                                        <DropShadow color="rgba(99,102,241,0.3)" radius="8" offsetX="0" offsetY="4"/>
                                    </effect>
                                </Button>
                            </children>
                        </GridPane>
                    </children>
                </StackPane>
            </children>
        </HBox>

        <!-- Кнопка назад (прежний размер) -->
        <Button fx:id="backButton" text="Назад" onAction="#handleBack"
                style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-font-weight: bold; -fx-min-width: 180; -fx-min-height: 45; -fx-background-color: #64748b; -fx-text-fill: white; -fx-background-radius: 10;"
                onMouseEntered="#handleMouseEnterExit" onMouseExited="#handleMouseExitExit">
            <effect>
                <DropShadow color="rgba(100,116,139,0.3)" radius="6" offsetX="0" offsetY="3"/>
            </effect>
            <VBox.margin>
                <Insets top="20.0"/>
            </VBox.margin>
        </Button>

        <!-- Футер (прежний размер) -->
        <VBox alignment="CENTER" spacing="5" style="-fx-padding: 20 0 0 0;">
            <children>
                <HBox alignment="CENTER" spacing="10">
                    <children>
                        <Label text="© 2023 Property Appraisal System"
                               style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12; -fx-text-fill: #64748b;"/>
                        <Label text="•"
                               style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12; -fx-text-fill: #adb5bd;"/>
                        <Label text="v1.0.0"
                               style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12; -fx-text-fill: #adb5bd;"/>
                    </children>
                </HBox>
                <Label text="Техническая поддержка: support@example.com"
                       style="-fx-font-family: 'Segoe UI'; -fx-font-size: 11; -fx-text-fill: #6c757d;"/>
            </children>
        </VBox>
    </children>
</VBox>