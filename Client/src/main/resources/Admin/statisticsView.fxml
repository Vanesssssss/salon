<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.LinearGradient?>
<?import javafx.scene.paint.Stop?>

<VBox fx:id="mainContainer" alignment="TOP_CENTER" fillWidth="false" prefHeight="600.0" prefWidth="800.0" spacing="20"
      style="-fx-padding: 20; -fx-background-color: linear-gradient(to bottom, #f0f4f8, #e2e8f0);"
      xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controllers.Admin.StatisticsController">

    <!-- Modern header with gradient and shadow -->
    <HBox alignment="CENTER" prefHeight="70.0" prefWidth="760.0"
          style="-fx-background-color: linear-gradient(to right, #0ea5e9, #10b981); -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 4);">
        <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: white;" text="Статистика" />
    </HBox>

    <!-- Chart container with shadow -->
    <PieChart fx:id="pieChart" prefHeight="390.0" prefWidth="760.0"
              style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 3);" />

    <!-- Back button -->
    <Button fx:id="backButton" onAction="#handleBack"
            onMouseEntered="#handleMouseEnterExit" onMouseExited="#handleMouseExitExit"
            style="-fx-background-radius: 10; -fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-font-weight: bold; -fx-background-color: #64748b; -fx-text-fill: white; -fx-pref-height: 40; -fx-pref-width: 150;">
        <effect>
            <DropShadow color="rgba(100,116,139,0.3)" radius="6" offsetX="0" offsetY="3"/>
        </effect>
        Назад
    </Button>
</VBox>