<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.paint.LinearGradient?>
<?import javafx.scene.paint.Stop?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<VBox fx:id="mainContainer" alignment="TOP_CENTER" spacing="20"
      style="-fx-padding: 25; -fx-background-color: linear-gradient(to bottom, #f0f4f8, #e2e8f0);"
      xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controllers.Admin.WorkMasterAdminController">

   <!-- Заголовок в стиле административной панели -->
   <VBox alignment="CENTER" spacing="10">
      <children>
         <StackPane>
            <children>
               <Rectangle width="450" height="60" arcWidth="15" arcHeight="15">
                  <fill>
                     <LinearGradient startX="0" startY="0" endX="1" endY="0">
                        <stops>
                           <Stop offset="0.0" color="#0d9488"/>
                           <Stop offset="1.0" color="#10b981"/>
                        </stops>
                     </LinearGradient>
                  </fill>
                  <effect>
                     <DropShadow color="rgba(0,0,0,0.1)" radius="8" offsetX="0" offsetY="4"/>
                  </effect>
               </Rectangle>
               <VBox alignment="CENTER" spacing="5">
                  <children>
                     <Text text="УПРАВЛЕНИЕ МАСТЕРАМИ"
                           style="-fx-font-family: 'Segoe UI'; -fx-font-size: 24; -fx-font-weight: bold; -fx-fill: white;">
                        <effect>
                           <DropShadow color="#ccfbf1" radius="1" offsetX="0" offsetY="1"/>
                        </effect>
                     </Text>
                     <Text text="MASTERS MANAGEMENT"
                           style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-fill: #f0fdfa;"/>
                  </children>
               </VBox>
            </children>
         </StackPane>
      </children>
   </VBox>

   <!-- Основной контент - форма ввода -->
   <HBox alignment="CENTER" spacing="30" style="-fx-padding: 25;">
      <children>
         <!-- Левая колонка полей ввода -->
         <StackPane prefWidth="350">
            <children>
               <Rectangle width="350" height="350" arcWidth="20" arcHeight="20" fill="#ffffff">
                  <effect>
                     <DropShadow color="rgba(0,0,0,0.08)" radius="15" offsetX="0" offsetY="8"/>
                  </effect>
               </Rectangle>

               <!-- Декоративные элементы -->
               <SVGPath fill="rgba(16,185,129,0.1)" content="M30,60 Q150,20 270,60 T330,60" stroke="transparent" strokeWidth="0"/>
               <Circle centerX="300" centerY="280" radius="60" fill="rgba(16,185,129,0.05)"/>

               <VBox alignment="CENTER" spacing="15" style="-fx-padding: 30;">
                  <children>
                     <TextField fx:id="loginField" promptText="Логин"
                                style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-background-radius: 8; -fx-padding: 10; -fx-border-color: #cbd5e1; -fx-border-radius: 8;"
                                prefWidth="280" prefHeight="40"/>

                     <TextField fx:id="passwordField" promptText="Пароль"
                                style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-background-radius: 8; -fx-padding: 10; -fx-border-color: #cbd5e1; -fx-border-radius: 8;"
                                prefWidth="280" prefHeight="40"/>

                     <TextField fx:id="lastNameField" promptText="Фамилия"
                                style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-background-radius: 8; -fx-padding: 10; -fx-border-color: #cbd5e1; -fx-border-radius: 8;"
                                prefWidth="280" prefHeight="40"/>

                     <TextField fx:id="firstNameField" promptText="Имя"
                                style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-background-radius: 8; -fx-padding: 10; -fx-border-color: #cbd5e1; -fx-border-radius: 8;"
                                prefWidth="280" prefHeight="40"/>
                  </children>
               </VBox>
            </children>
         </StackPane>

         <!-- Правая колонка полей ввода -->
         <StackPane prefWidth="350">
            <children>
               <Rectangle width="350" height="350" arcWidth="20" arcHeight="20" fill="#ffffff">
                  <effect>
                     <DropShadow color="rgba(0,0,0,0.08)" radius="15" offsetX="0" offsetY="8"/>
                  </effect>
               </Rectangle>

               <!-- Декоративные элементы -->
               <SVGPath fill="rgba(16,185,129,0.1)" content="M30,180 Q150,140 270,180 T330,180" stroke="transparent" strokeWidth="0"/>
               <Circle centerX="50" centerY="80" radius="50" fill="rgba(16,185,129,0.05)"/>

               <VBox alignment="CENTER" spacing="15" style="-fx-padding: 30;">
                  <children>
                     <TextField fx:id="experienceField" promptText="Стаж (лет)"
                                style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-background-radius: 8; -fx-padding: 10; -fx-border-color: #cbd5e1; -fx-border-radius: 8;"
                                prefWidth="280" prefHeight="40"/>

                     <TextField fx:id="startWorkField" promptText="Начало работы (чч:мм)"
                                style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-background-radius: 8; -fx-padding: 10; -fx-border-color: #cbd5e1; -fx-border-radius: 8;"
                                prefWidth="280" prefHeight="40"/>

                     <TextField fx:id="endWorkField" promptText="Конец работы (чч:мм)"
                                style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-background-radius: 8; -fx-padding: 10; -fx-border-color: #cbd5e1; -fx-border-radius: 8;"
                                prefWidth="280" prefHeight="40"/>

                     <TextField fx:id="specializationField" promptText="Специализация"
                                style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-background-radius: 8; -fx-padding: 10; -fx-border-color: #cbd5e1; -fx-border-radius: 8;"
                                prefWidth="280" prefHeight="40"/>
                  </children>
               </VBox>
            </children>
         </StackPane>
      </children>
   </HBox>

   <!-- Кнопки -->
   <HBox alignment="CENTER" spacing="20">
      <Button fx:id="addMasterButton" text="Добавить мастера" onAction="#saveMasterInfo"
              style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-font-weight: bold; -fx-min-width: 220; -fx-min-height: 45; -fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 10;"
              onMouseEntered="#handleMouseEnter" onMouseExited="#handleMouseExit">
         <effect>
            <DropShadow color="rgba(16,185,129,0.3)" radius="8" offsetX="0" offsetY="4"/>
         </effect>
      </Button>

      <Button fx:id="backButton" text="Назад" onAction="#handleBack"
              style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-font-weight: bold; -fx-min-width: 180; -fx-min-height: 45; -fx-background-color: #64748b; -fx-text-fill: white; -fx-background-radius: 10;"
              onMouseEntered="#handleMouseEnterExit" onMouseExited="#handleMouseExitExit">
         <effect>
            <DropShadow color="rgba(100,116,139,0.3)" radius="6" offsetX="0" offsetY="3"/>
         </effect>
      </Button>
   </HBox>

   <!-- Футер -->
   <VBox alignment="CENTER" spacing="5" style="-fx-padding: 20 0 0 0;">
      <children>
         <HBox alignment="CENTER" spacing="10">
            <children>
               <Label text="© 2023 Hair Salon System"
                      style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12; -fx-text-fill: #64748b;"/>
               <Label text="•"
                      style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12; -fx-text-fill: #adb5bd;"/>
               <Label text="v1.0.0"
                      style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12; -fx-text-fill: #adb5bd;"/>
            </children>
         </HBox>
         <Label text="Техническая поддержка: support@example.com"
                style="-fx-font-family: 'Segoe UI'; -fx-font-size: 11; -fx-text-fill: #6c757d;"/>
      </children>
   </VBox>
</VBox>